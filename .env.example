# .env.example - 환경변수 설정 예제
# 로컬 개발: 이 파일을 복사하여 .env 파일을 만들고 실제 값을 입력하세요
# 운영(Vercel): Project Settings > Environment Variables 에 같은 이름으로 등록하세요

# 서버 설정 (로컬 개발용, Vercel에는 등록 불필요)
NODE_ENV=development
PORT=3001

# KIPRIS API (출원특허 검색 등) - 필수
KIPRIS_API_KEY=your_kipris_api_key_here
KIPRIS_API_BASE_URL=https://plus.kipris.or.kr/kipo-api/kipi

# 특허청 등록원부 API (공공데이터포털, 등록특허/납부이력 조회) - 필수
PATENT_OFFICE_API_KEY=your_patent_office_api_key_here
PATENT_OFFICE_API_URL=https://apis.data.go.kr/1430000/PttRgstRtInfoInqSvc/getBusinessRightList

# Supabase (회원·이용기록·알림 발송 기록 DB) - 필수
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 관리자 로그인 세션 서명 키 (임의의 긴 문자열) - 필수
SESSION_SECRET=change_me_to_a_long_random_string

# 관리자 납부기한 알림 메일 (Resend)
RESEND_API_KEY=re_your_resend_api_key
REMINDER_FROM=유니크 특허사무소 <noreply@unicpat.com>
REMINDER_REPLY_TO=office@example.com
# 메일 속 "등록특허 현황 확인하기" 버튼 주소 (선택, 없으면 접속한 주소 사용)
SITE_URL=https://www.ipbot1.com
