<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <title><%= title %> - 유니크 특허사무소</title>

    <!-- SEO Meta Tags -->
    <meta name="description" content="유니크 특허사무소 관리자 페이지">
    <meta name="robots" content="noindex, nofollow">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="/css/ejs-style.css">
    <link rel="stylesheet" href="/css/admin.css">

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="alternate icon" href="/images/favicon.svg">

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#2563eb">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="유니크특허">
    <link rel="apple-touch-icon" href="/images/icon-192x192.png">
</head>
<body>
    <header class="header admin-header">
        <div class="container">
            <div class="header-content">
                <a href="/" class="logo">
                    유니크<span>특허</span>
                    <span class="admin-badge">관리자</span>
                </a>
                <button class="hamburger" id="hamburgerBtn" aria-label="메뉴 열기">
                    <span></span><span></span><span></span>
                </button>
                <nav class="nav-tabs" id="navTabs">
                    <a href="/registered" class="nav-link">등록특허 현황</a>
                    <a href="/application2" class="nav-link">출원특허 현황</a>
                    <a href="/admin/stats" class="nav-link">이용 통계</a>
                    <a href="/admin/reminders" class="nav-link">납부기한 알림</a>
                    <a href="/admin" class="nav-link active">기존 회원</a>
                    <a href="javascript:void(0)" class="nav-link" id="logoutBtn">로그아웃</a>
                </nav>
            </div>
        </div>
    </header>

    <main class="main-content">
        <div class="container">
            <div class="page-title">
                <h1>회원 관리</h1>
                <p>등록된 회원 정보를 조회하고 관리합니다</p>
            </div>

            <!-- 검색 섹션 -->
            <section class="search-section">
                <form class="search-form" id="searchForm">
                    <div class="form-group">
                        <label for="searchInput" class="form-label">이름 검색</label>
                        <div class="input-group">
                            <input
                                type="text"
                                id="searchInput"
                                name="searchInput"
                                class="form-input"
                                placeholder="회원 이름을 입력하세요"
                            >
                            <button type="submit" class="btn btn-primary" id="searchBtn">
                                검색
                            </button>
                            <button type="button" class="btn btn-secondary" id="resetBtn">
                                초기화
                            </button>
                        </div>
                    </div>
                </form>
            </section>

            <!-- 결과 섹션 -->
            <section class="results-section" id="resultsSection">
                <div class="results-header">
                    <div class="results-info">
                        <div class="info-item">
                            <span class="info-label">전체 회원:</span>
                            <span class="info-value" id="totalCount">0</span>명
                        </div>
                    </div>
                    <button type="button" class="btn btn-primary" id="createBtn">+ 신규 회원 등록</button>
                </div>

                <div class="table-container">
                    <table class="admin-table" id="userTable">
                        <thead>
                            <tr>
                                <th>이름</th>
                                <th>이메일</th>
                                <th>전화번호</th>
                                <th>사업자번호</th>
                                <th>고객번호</th>
                                <th>상태</th>
                                <th>역할</th>
                                <th>가입일</th>
                                <th>관리</th>
                            </tr>
                        </thead>
                        <tbody id="userTableBody">
                            <!-- 회원 목록이 여기에 표시됩니다 -->
                        </tbody>
                    </table>
                </div>

                <!-- 빈 상태 -->
                <div class="empty-state" id="emptyState" style="display: none;">
                    <div class="empty-icon">👥</div>
                    <div class="empty-title">회원이 없습니다</div>
                    <div class="empty-description">검색 결과가 없거나 등록된 회원이 없습니다.</div>
                </div>

                <!-- 페이지네이션 -->
                <div class="pagination-container" id="paginationContainer">
                    <div class="pagination-info" id="paginationInfo">
                        <!-- 페이지 정보 -->
                    </div>
                    <div class="pagination-controls" id="paginationControls">
                        <!-- 페이지 버튼 -->
                    </div>
                </div>
            </section>
        </div>
    </main>

    <!-- 신규 회원 등록 모달 -->
    <div id="createModal" class="modal-overlay" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h2>신규 회원 등록</h2>
                <button type="button" class="modal-close" onclick="closeCreateModal()">&times;</button>
            </div>
            <form id="createForm">
                <div class="form-group">
                    <label class="form-label">이름 <span style="color:#ef4444;">*</span></label>
                    <input type="text" id="createName" class="form-input" required maxlength="100" placeholder="회원명 또는 회사명">
                </div>
                <div class="form-group">
                    <label class="form-label">이메일 <span style="color:#ef4444;">*</span></label>
                    <input type="email" id="createEmail" class="form-input" required maxlength="200" placeholder="납부기한 알림 메일을 받을 주소">
                </div>
                <div class="form-group">
                    <label class="form-label">전화번호</label>
                    <input type="tel" id="createPhone" class="form-input" placeholder="010-0000-0000">
                </div>
                <div class="form-group">
                    <label class="form-label">사업자번호</label>
                    <input type="text" id="createBusinessNumber" class="form-input" placeholder="10자리 숫자" maxlength="12" inputmode="numeric">
                </div>
                <div class="form-group">
                    <label class="form-label">고객번호</label>
                    <input type="text" id="createCustomerNumber" class="form-input" placeholder="12자리 숫자" maxlength="14" inputmode="numeric">
                    <p style="margin:0.35rem 0 0;font-size:0.8rem;color:#64748b;">고객번호 또는 사업자번호가 있어야 납부기한 알림 대상이 됩니다.</p>
                </div>
                <div class="form-group">
                    <label class="form-label">감면유형</label>
                    <select id="createDiscountType" class="form-input">
                        <option value="type1">개인/중소기업/공공연구기관/전담조직/지방자치단체</option>
                        <option value="type1_1">중소기업 + 직무발명보상우수기업/지식재산경영인증기업</option>
                        <option value="type2">중견기업</option>
                        <option value="type2_1">중견기업 + 직무발명보상우수기업/지식재산경영인증기업</option>
                        <option value="none">해당사항 없음</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">역할</label>
                    <select id="createRole" class="form-input">
                        <option value="user">일반 사용자</option>
                        <option value="admin">관리자</option>
                    </select>
                </div>
                <div class="form-group" id="createPasswordGroup" style="display: none;">
                    <label class="form-label">비밀번호 <span style="color:#ef4444;">*</span></label>
                    <input type="password" id="createPassword" class="form-input" minlength="8" autocomplete="new-password" placeholder="관리자 로그인용, 8자 이상">
                </div>
                <div id="createErrorMessage" class="error-message" style="display: none;"></div>
                <div id="createSuccessMessage" class="success-message" style="display: none;"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="closeCreateModal()">취소</button>
                    <button type="submit" class="btn btn-primary" id="createSubmitBtn">등록</button>
                </div>
            </form>
        </div>
    </div>

    <!-- 회원 정보 수정 모달 -->
    <div id="editModal" class="modal-overlay" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h2>회원 정보 수정</h2>
                <button type="button" class="modal-close" onclick="closeEditModal()">&times;</button>
            </div>
            <form id="editForm">
                <input type="hidden" id="editUserId">
                <div class="form-group">
                    <label class="form-label">이름</label>
                    <input type="text" id="editName" class="form-input" required>
                </div>
                <div class="form-group">
                    <label class="form-label">이메일</label>
                    <input type="email" id="editEmail" class="form-input" required>
                </div>
                <div class="form-group">
                    <label class="form-label">전화번호</label>
                    <input type="tel" id="editPhone" class="form-input" placeholder="010-0000-0000">
                </div>
                <div class="form-group">
                    <label class="form-label">사업자번호</label>
                    <input type="text" id="editBusinessNumber" class="form-input" placeholder="10자리 숫자" maxlength="10">
                </div>
                <div class="form-group">
                    <label class="form-label">고객번호</label>
                    <input type="text" id="editCustomerNumber" class="form-input" placeholder="12자리 숫자" maxlength="12">
                </div>
                <div class="form-group">
                    <label class="form-label">역할</label>
                    <select id="editRole" class="form-input">
                        <option value="user">일반 사용자</option>
                        <option value="admin">관리자</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">새 비밀번호</label>
                    <input type="password" id="editPassword" class="form-input" minlength="8" autocomplete="new-password" placeholder="변경할 때만 입력 (8자 이상)">
                </div>
                <div class="form-group">
                    <label class="form-label">새 비밀번호 확인</label>
                    <input type="password" id="editPasswordConfirm" class="form-input" autocomplete="new-password" placeholder="새 비밀번호를 한 번 더 입력">
                    <p style="margin:0.35rem 0 0;font-size:0.8rem;color:#64748b;">비워 두면 비밀번호는 그대로 유지됩니다. 본인 계정의 이메일·비밀번호를 바꾸면 다시 로그인해야 합니다.</p>
                </div>
                <div id="editErrorMessage" class="error-message" style="display: none;"></div>
                <div id="editSuccessMessage" class="success-message" style="display: none;"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="closeEditModal()">취소</button>
                    <button type="submit" class="btn btn-primary" id="editSubmitBtn">저장</button>
                </div>
            </form>
        </div>
    </div>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-text">
                    <strong>유니크 특허사무소</strong> - 관리자 시스템
                </div>
                <div class="footer-text" style="margin-top: 1rem; font-size: 0.875rem; color: #94a3b8;">
                    &copy; 2024 유니크 특허사무소. All rights reserved.
                </div>
            </div>
        </div>
    </footer>

    <!-- JavaScript -->
    <script src="/js/main.js"></script>
    <script src="/js/admin.js?v=2026.10.21.v2"></script>

    <!-- 클라이언트 측 인증 및 권한 체크 -->
    <script>
    (function() {
        var cookies = document.cookie.split(';');
        var hasLogin = cookies.some(function(c) { return c.trim().startsWith('loginStatus=') && c.includes('true'); });
        var isAdmin = cookies.some(function(c) { return c.trim().startsWith('userRole=') && c.includes('admin'); });
        if (!hasLogin || !isAdmin) {
            window.location.href = '/';
        }
    })();
    </script>

    <!-- 로그아웃 기능 -->
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        var logoutBtn = document.getElementById('logoutBtn');
        if (logoutBtn) {
            logoutBtn.addEventListener('click', function(e) {
                e.preventDefault();
                document.cookie = 'loginStatus=; Path=/; Max-Age=0';
                document.cookie = 'userRole=; Path=/; Max-Age=0';
                fetch('/api/logout').catch(function() {});
                window.location.href = '/?logout=1';
            });
        }
    });
    </script>

    <!-- Service Worker 등록 -->
    <script>
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js')
                .then(reg => console.log('SW 등록 성공:', reg.scope))
                .catch(err => console.log('SW 등록 실패:', err));
        });
    }
    </script>
</body>
</html>
