    <!-- 나의 정보 수정 모달 -->
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        var myInfoBtn = document.getElementById('myInfoBtn');
        if (myInfoBtn) {
            myInfoBtn.addEventListener('click', function(e) {
                e.preventDefault();
                showMyInfoModal();
            });
        }
    });

    function showMyInfoModal() {
        window.closeMyInfoModal = function() {
            var modal = document.getElementById('myInfoModal');
            if (modal) modal.remove();
        };

        var modalHTML = '<div id="myInfoModal" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); display: flex; justify-content: center; align-items: center; z-index: 1000;">' +
            '<div style="background: white; border-radius: 8px; padding: 2rem; width: 90%; max-width: 500px; max-height: 90vh; overflow-y: auto; box-shadow: 0 10px 25px rgba(0,0,0,0.15);">' +
                '<div style="border-bottom: 2px solid #F59E0B; padding-bottom: 1rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">' +
                    '<h2 style="color: #0F172A; font-size: 1.5rem; font-weight: 700; margin: 0;">나의 정보 수정</h2>' +
                    '<button type="button" onclick="closeMyInfoModal()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #6b7280;">&times;</button>' +
                '</div>' +
                '<form id="myInfoForm">' +
                    '<div style="margin-bottom: 1rem;">' +
                        '<label style="display: block; color: #374151; font-weight: 500; margin-bottom: 0.5rem;">현재 이메일 (로그인 ID)</label>' +
                        '<input type="email" id="myinfo_current_email" required style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box; background: #f9fafb;" placeholder="현재 이메일을 입력하세요">' +
                    '</div>' +
                    '<div style="margin-bottom: 1rem;">' +
                        '<label style="display: block; color: #374151; font-weight: 500; margin-bottom: 0.5rem;">현재 패스워드 <span style="color: #ef4444;">*</span></label>' +
                        '<input type="password" id="myinfo_current_password" required style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box;" placeholder="본인 확인을 위해 현재 패스워드를 입력하세요">' +
                    '</div>' +
                    '<hr style="border: none; border-top: 1px solid #e5e7eb; margin: 1.5rem 0;">' +
                    '<p style="color: #6b7280; font-size: 0.85rem; margin-bottom: 1rem;">변경할 항목만 입력하세요. 비워두면 기존 정보가 유지됩니다.</p>' +
                    '<div style="margin-bottom: 1rem;">' +
                        '<label style="display: block; color: #374151; font-weight: 500; margin-bottom: 0.5rem;">새 이메일</label>' +
                        '<input type="email" id="myinfo_new_email" style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box;" placeholder="변경할 이메일 (선택)">' +
                    '</div>' +
                    '<div style="margin-bottom: 1rem;">' +
                        '<label style="display: block; color: #374151; font-weight: 500; margin-bottom: 0.5rem;">연락처</label>' +
                        '<input type="tel" id="myinfo_phone" style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box;" placeholder="변경할 연락처 (선택)">' +
                    '</div>' +
                    '<div style="margin-bottom: 1rem;">' +
                        '<label style="display: block; color: #374151; font-weight: 500; margin-bottom: 0.5rem;">사업자번호</label>' +
                        '<div style="display: flex; gap: 0.5rem;">' +
                            '<input type="text" id="myinfo_business_number" maxlength="10" style="flex: 1; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box;" placeholder="10자리 숫자 (선택)">' +
                            '<button type="button" id="myinfo_lookup_btn" style="padding: 0.75rem 1rem; background: #F59E0B; color: white; border: none; border-radius: 4px; cursor: pointer; white-space: nowrap;">고객번호 조회</button>' +
                        '</div>' +
                    '</div>' +
                    '<div style="margin-bottom: 1rem;">' +
                        '<label style="display: block; color: #374151; font-weight: 500; margin-bottom: 0.5rem;">고객번호</label>' +
                        '<input type="text" id="myinfo_customer_number" maxlength="12" style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box; background: #f9fafb;" placeholder="12자리 숫자 (자동 조회됨)" readonly>' +
                    '</div>' +
                    '<div style="margin-bottom: 1rem;">' +
                        '<label style="display: block; color: #374151; font-weight: 500; margin-bottom: 0.5rem;">새 패스워드</label>' +
                        '<input type="password" id="myinfo_new_password" minlength="6" style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box;" placeholder="변경할 패스워드 (선택, 6자 이상)">' +
                    '</div>' +
                    '<div style="margin-bottom: 1.5rem;">' +
                        '<label style="display: block; color: #374151; font-weight: 500; margin-bottom: 0.5rem;">새 패스워드 확인</label>' +
                        '<input type="password" id="myinfo_new_password_confirm" minlength="6" style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box;" placeholder="새 패스워드를 다시 입력하세요">' +
                    '</div>' +
                    '<div id="myInfoErrorMessage" style="display: none; color: #ef4444; background: #fef2f2; border: 1px solid #fecaca; padding: 0.75rem; border-radius: 4px; margin-bottom: 1rem; font-size: 0.9rem;"></div>' +
                    '<div id="myInfoSuccessMessage" style="display: none; color: #059669; background: #ecfdf5; border: 1px solid #a7f3d0; padding: 0.75rem; border-radius: 4px; margin-bottom: 1rem; font-size: 0.9rem;"></div>' +
                    '<div style="display: flex; gap: 1rem; justify-content: flex-end;">' +
                        '<button type="button" onclick="closeMyInfoModal()" style="padding: 0.75rem 1.5rem; border: 1px solid #d1d5db; background: white; color: #374151; border-radius: 4px; cursor: pointer; font-weight: 500;">취소</button>' +
                        '<button type="submit" id="myInfoSubmitBtn" style="padding: 0.75rem 1.5rem; background: #F59E0B; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 500;">정보 수정</button>' +
                    '</div>' +
                '</form>' +
            '</div>' +
        '</div>';

        document.body.insertAdjacentHTML('beforeend', modalHTML);

        document.getElementById('myInfoForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            var errorDiv = document.getElementById('myInfoErrorMessage');
            var successDiv = document.getElementById('myInfoSuccessMessage');
            errorDiv.style.display = 'none';
            successDiv.style.display = 'none';

            var currentEmail = document.getElementById('myinfo_current_email').value;
            var currentPassword = document.getElementById('myinfo_current_password').value;
            var newEmail = document.getElementById('myinfo_new_email').value;
            var phone = document.getElementById('myinfo_phone').value;
            var newPassword = document.getElementById('myinfo_new_password').value;
            var newPasswordConfirm = document.getElementById('myinfo_new_password_confirm').value;

            if (!currentEmail || !currentPassword) {
                errorDiv.textContent = '현재 이메일과 패스워드를 입력해주세요.';
                errorDiv.style.display = 'block';
                return;
            }
            if (newPassword && newPassword !== newPasswordConfirm) {
                errorDiv.textContent = '새 패스워드가 일치하지 않습니다.';
                errorDiv.style.display = 'block';
                return;
            }
            if (newPassword && newPassword.length < 6) {
                errorDiv.textContent = '새 패스워드는 6자 이상이어야 합니다.';
                errorDiv.style.display = 'block';
                return;
            }
            var businessNumber = document.getElementById('myinfo_business_number').value.trim();
            var customerNumber = document.getElementById('myinfo_customer_number').value.trim();

            if (!newEmail && !phone && !newPassword && !businessNumber && !customerNumber) {
                errorDiv.textContent = '변경할 항목을 하나 이상 입력해주세요.';
                errorDiv.style.display = 'block';
                return;
            }

            var submitBtn = document.getElementById('myInfoSubmitBtn');
            submitBtn.disabled = true;
            submitBtn.textContent = '처리 중...';

            try {
                var response = await fetch('/api/update-profile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        current_email: currentEmail,
                        current_password: currentPassword,
                        new_email: newEmail || undefined,
                        phone: phone || undefined,
                        business_number: businessNumber || undefined,
                        customer_number: customerNumber || undefined,
                        new_password: newPassword || undefined
                    })
                });
                var result = await response.json();
                if (result.success) {
                    successDiv.textContent = result.message || '정보가 수정되었습니다.';
                    successDiv.style.display = 'block';
                } else {
                    errorDiv.textContent = result.message || '정보 수정에 실패했습니다.';
                    errorDiv.style.display = 'block';
                }
            } catch (error) {
                errorDiv.textContent = '정보 수정 처리 중 오류가 발생했습니다.';
                errorDiv.style.display = 'block';
            }
            submitBtn.textContent = '정보 수정';
            submitBtn.disabled = false;
        });

        // 사업자번호로 고객번호 조회 버튼 이벤트
        document.getElementById('myinfo_lookup_btn').addEventListener('click', async function() {
            var businessNumber = document.getElementById('myinfo_business_number').value.trim();
            var errorDiv = document.getElementById('myInfoErrorMessage');
            var customerNumberInput = document.getElementById('myinfo_customer_number');

            errorDiv.style.display = 'none';

            if (!businessNumber) {
                errorDiv.textContent = '사업자번호를 입력해주세요.';
                errorDiv.style.display = 'block';
                return;
            }

            if (!/^\d{10}$/.test(businessNumber)) {
                errorDiv.textContent = '사업자번호는 10자리 숫자여야 합니다.';
                errorDiv.style.display = 'block';
                return;
            }

            var lookupBtn = this;
            lookupBtn.disabled = true;
            lookupBtn.textContent = '조회 중...';

            try {
                var response = await fetch('/api/lookup-customer', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ business_number: businessNumber })
                });
                var result = await response.json();

                if (result.success && result.customer_number) {
                    customerNumberInput.value = result.customer_number;
                    customerNumberInput.style.backgroundColor = '#ecfdf5';
                } else {
                    errorDiv.textContent = result.message || '고객번호를 찾을 수 없습니다.';
                    errorDiv.style.display = 'block';
                }
            } catch (error) {
                errorDiv.textContent = '고객번호 조회 중 오류가 발생했습니다.';
                errorDiv.style.display = 'block';
            }

            lookupBtn.disabled = false;
            lookupBtn.textContent = '고객번호 조회';
        });
    }
    </script>

    <!-- 검색 및 이벤트 스크립트 -->
    <script>
    let currentPatents = [];
    let allPatents = [];
    let currentPage = 1;
    let currentFilter = '전체';
    const itemsPerPage = 10;

    // 출원번호 포맷 (1020200001867 → 10-2020-0001867)
    function formatApplicationNumber(num) {
        if (!num || num === '-') return '-';
        var clean = num.replace(/[^0-9]/g, '');
        if (clean.length === 13) return clean.substring(0,2) + '-' + clean.substring(2,6) + '-' + clean.substring(6);
        return num;
    }

    // 발명자 이름 표시 제한 (2명까지, 3명 이상이면 ... 표시)
    function formatInventorName(name) {
        if (!name || name === '-') return '-';
        var names = name.split(',').map(function(n) { return n.trim(); }).filter(Boolean);
        if (names.length <= 2) return names.join(', ');
        return names[0] + ', ' + names[1] + ' ...';
    }

    // 검색 폼 제출 이벤트
    document.getElementById('searchForm').addEventListener('submit', async function(e) {
        e.preventDefault();

        const customerNumber = document.getElementById('customerNumber').value.trim();
        const searchBtn = document.getElementById('searchBtn');
        const originalText = searchBtn.innerHTML;

        if (!/^\d{12}$/.test(customerNumber)) {
            showError('고객번호는 12자리 숫자여야 합니다.');
            return;
        }

        hideError();
        showLoading(searchBtn);

        try {
            const response = await fetch('/api/search-application2', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ customerNumber })
            });

            const data = await response.json();

            if (!data.success) {
                throw new Error(data.error || '검색 중 오류가 발생했습니다.');
            }

            displayResults(data);
        } catch (error) {
            console.error('검색 오류:', error);
            showError(error.message);
        } finally {
            hideLoading(searchBtn, originalText);
        }
    });

    // 결과 표시
    function displayResults(data) {
        allPatents = data.patents || [];
        currentFilter = '전체';
        currentPatents = allPatents.slice();
        currentPage = 1;

        if (allPatents.length === 0) {
            document.getElementById('patentTableBody').innerHTML =
                '<tr><td colspan="11" style="text-align:center; padding:2rem; color:#6b7280;">해당 고객번호로 출원 중인 특허를 찾을 수 없습니다.</td></tr>';
            var pc = document.getElementById('paginationContainer');
            if (pc) pc.style.display = 'none';
            document.getElementById('filterSection').style.display = 'none';
        } else {
            buildFilterButtons();
            displayPaginatedResults();
        }
    }

    // 필터 버튼 생성
    function buildFilterButtons() {
        var filterSection = document.getElementById('filterSection');
        var filterButtons = document.getElementById('filterButtons');

        // 고유 상태값 추출
        var statuses = [];
        allPatents.forEach(function(p) {
            var s = p.currentStatus;
            if (s && s !== '-' && statuses.indexOf(s) === -1) {
                statuses.push(s);
            }
        });

        if (statuses.length <= 1) {
            filterSection.style.display = 'none';
            return;
        }

        filterSection.style.display = 'block';
        filterButtons.innerHTML = '';

        // "전체" 버튼
        var allBtn = document.createElement('button');
        allBtn.textContent = '전체 (' + allPatents.length + ')';
        allBtn.className = 'filter-btn active';
        allBtn.setAttribute('data-filter', '전체');
        allBtn.style.cssText = 'padding:0.4rem 0.8rem; border:1px solid #d1d5db; border-radius:4px; cursor:pointer; font-size:0.85rem; background:#F59E0B; color:white; font-weight:500;';
        allBtn.addEventListener('click', function() { applyFilter('전체'); });
        filterButtons.appendChild(allBtn);

        // 상태별 버튼
        statuses.forEach(function(status) {
            var count = allPatents.filter(function(p) { return p.currentStatus === status; }).length;
            var btn = document.createElement('button');
            btn.textContent = status + ' (' + count + ')';
            btn.className = 'filter-btn';
            btn.setAttribute('data-filter', status);
            btn.style.cssText = 'padding:0.4rem 0.8rem; border:1px solid #d1d5db; border-radius:4px; cursor:pointer; font-size:0.85rem; background:white; color:#374151;';
            btn.addEventListener('click', function() { applyFilter(status); });
            filterButtons.appendChild(btn);
        });
    }

    // 필터 적용
    function applyFilter(filter) {
        currentFilter = filter;
        currentPage = 1;

        if (filter === '전체') {
            currentPatents = allPatents.slice();
        } else {
            currentPatents = allPatents.filter(function(p) { return p.currentStatus === filter; });
        }

        // 버튼 스타일 업데이트
        var btns = document.querySelectorAll('#filterButtons .filter-btn');
        btns.forEach(function(btn) {
            if (btn.getAttribute('data-filter') === filter) {
                btn.style.background = '#F59E0B';
                btn.style.color = 'white';
                btn.style.fontWeight = '500';
            } else {
                btn.style.background = 'white';
                btn.style.color = '#374151';
                btn.style.fontWeight = 'normal';
            }
        });

        displayPaginatedResults();
    }

    // 페이지네이션된 결과 표시
    function displayPaginatedResults() {
        const tableBody = document.getElementById('patentTableBody');
        const totalPages = Math.ceil(currentPatents.length / itemsPerPage);

        tableBody.innerHTML = '';

        const startIndex = (currentPage - 1) * itemsPerPage;
        const endIndex = Math.min(startIndex + itemsPerPage, currentPatents.length);
        const paginatedPatents = currentPatents.slice(startIndex, endIndex);

        paginatedPatents.forEach(function(patent) {
            const row = document.createElement('tr');
            const safeValue = function(value) { return value && value !== '-' ? value : '-'; };

            row.innerHTML =
                '<td class="patent-number">' + formatApplicationNumber(safeValue(patent.applicationNumber)) + '</td>' +
                '<td class="patent-number">' + safeValue(patent.registrationNumber) + '</td>' +
                '<td class="applicant-name-clean applicant-name">' + safeValue(patent.applicantName) + '</td>' +
                '<td>' + formatInventorName(safeValue(patent.inventorName)) + '</td>' +
                '<td>' + formatDate(patent.applicationDate) + '</td>' +
                '<td>' + safeValue(patent.priorityApplicationDate) + '</td>' +
                '<td>' + safeValue(patent.pctDeadline) + '</td>' +
                '<td class="invention-title-natural invention-title">' + safeValue(patent.inventionTitle) + '</td>' +
                '<td>' + safeValue(patent.currentStatus) + '</td>' +
                '<td><span class="no-file">-</span></td>' +
                '<td><span class="no-file">-</span></td>';
            tableBody.appendChild(row);
        });

        createPaginationControls(totalPages);
    }

    // 페이지네이션 컨트롤 생성
    function createPaginationControls(totalPages) {
        var paginationContainer = document.getElementById('paginationContainer');

        if (!paginationContainer) {
            paginationContainer = document.createElement('div');
            paginationContainer.id = 'paginationContainer';
            paginationContainer.className = 'pagination-container';
            var tableContainer = document.querySelector('.table-container');
            tableContainer.parentNode.insertBefore(paginationContainer, tableContainer.nextSibling);
        }

        if (totalPages <= 1) {
            paginationContainer.style.display = 'none';
            return;
        }

        paginationContainer.style.display = 'flex';

        var html = '<div class="pagination-info">총 ' + currentPatents.length + '건 (페이지 ' + currentPage + '/' + totalPages + ')</div>';
        html += '<div class="pagination-controls">';

        if (currentPage > 1) {
            html += '<button class="pagination-btn" data-page="1">« 처음</button>';
            html += '<button class="pagination-btn" data-page="' + (currentPage - 1) + '">‹ 이전</button>';
        } else {
            html += '<button class="pagination-btn disabled">« 처음</button>';
            html += '<button class="pagination-btn disabled">‹ 이전</button>';
        }

        var endPage = Math.min(totalPages, currentPage + 2);
        var startPage = Math.max(1, endPage - 4);
        endPage = Math.min(totalPages, startPage + 4);

        for (var i = startPage; i <= endPage; i++) {
            if (i === currentPage) {
                html += '<button class="pagination-btn active">' + i + '</button>';
            } else {
                html += '<button class="pagination-btn" data-page="' + i + '">' + i + '</button>';
            }
        }

        if (currentPage < totalPages) {
            html += '<button class="pagination-btn" data-page="' + (currentPage + 1) + '">다음 ›</button>';
            html += '<button class="pagination-btn" data-page="' + totalPages + '">마지막 »</button>';
        } else {
            html += '<button class="pagination-btn disabled">다음 ›</button>';
            html += '<button class="pagination-btn disabled">마지막 »</button>';
        }

        html += '</div>';
        paginationContainer.innerHTML = html;

        var btns = paginationContainer.querySelectorAll('.pagination-btn[data-page]');
        btns.forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                var targetPage = parseInt(this.getAttribute('data-page'));
                if (targetPage && targetPage !== currentPage) {
                    currentPage = targetPage;
                    displayPaginatedResults();
                    document.querySelector('.table-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });
    }

    // 날짜 포맷 (YYYY-MM-DD 또는 YYYYMMDD → YYYY-MM-DD)
    function formatDate(dateStr) {
        if (!dateStr || dateStr === '-') return '-';
        // 이미 YYYY-MM-DD 형식이면 그대로
        if (/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) return dateStr;
        // YYYYMMDD → YYYY-MM-DD
        if (/^\d{8}$/.test(dateStr)) {
            return dateStr.substring(0,4) + '-' + dateStr.substring(4,6) + '-' + dateStr.substring(6,8);
        }
        return dateStr;
    }

    // Event listeners setup
    document.addEventListener('DOMContentLoaded', function() {
        var logoutBtn = document.getElementById('logoutBtn');
        if (logoutBtn) {
            logoutBtn.addEventListener('click', function(e) {
                e.preventDefault();
                document.cookie = 'loginStatus=; Path=/; Max-Age=0';
                fetch('/api/logout').catch(function() {});
                window.location.href = '/';
            });
        }
    });
    </script>
</body>
</html>
