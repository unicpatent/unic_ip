<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <title><%= title %> - 유니크 특허사무소</title>

    <!-- SEO Meta Tags -->
    <meta name="description" content="유니크 특허사무소 특허 현황 조회 시스템">
    <meta name="keywords" content="특허, 특허사무소, 특허 현황, 등록특허, 출원특허, 유니크">
    <meta name="author" content="유니크 특허사무소">

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="<%= title %> - 유니크 특허사무소">
    <meta property="og:description" content="유니크 특허사무소 특허 현황 조회 시스템">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://unicpat.com">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="/css/ejs-style.css">
    <link rel="stylesheet" href="/css/annual-fee-status.css">

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="alternate icon" href="/images/favicon.svg">
</head>
<body>
    <header class="header">
        <div class="container">
            <div class="header-content">
                <a href="/" class="logo">
                    유니크<span>특허</span>
                </a>
                <nav class="nav-tabs">
                    <a href="/registered" class="nav-link">등록특허 현황</a>
                    <a href="/application" class="nav-link">출원특허 현황</a>
                    <a href="/application2" class="nav-link active">출원특허 현황2</a>
                    <a href="https://www.unicpat.com" class="nav-link" target="_blank">유니크 홈페이지</a>
                    <a href="javascript:void(0)" class="nav-link" id="myInfoBtn">나의 정보 수정</a>
                    <a href="javascript:void(0)" class="nav-link" id="logoutBtn">로그아웃</a>
                </nav>
            </div>
        </div>
    </header>

<main class="main-content">
    <div class="container">
        <div class="page-title">
            <h1>출원특허 현황2</h1>
            <p>고객번호로 출원 중인 특허 목록을 조회합니다</p>
        </div>

        <!-- 검색 섹션 -->
        <section class="search-section">
            <form class="search-form" id="searchForm">
                <div class="form-group">
                    <label for="customerNumber" class="form-label">고객번호</label>
                    <div class="input-group">
                        <input
                            type="text"
                            id="customerNumber"
                            name="customerNumber"
                            class="form-input customer-number-input"
                            placeholder="예: 120190612244"
                            maxlength="12"
                            pattern="[0-9]{12}"
                            required
                        >
                        <button type="submit" class="btn btn-primary" id="searchBtn">
                            🔍 검색하기
                        </button>
                    </div>
                    <div class="form-hint">12자리 숫자 입력하세요</div>
                </div>
            </form>
        </section>

        <!-- 테이블 섹션 (항상 표시) -->
        <div class="table-container">
            <table class="patent-table" id="patentTable">
                <thead>
                    <tr>
                        <th>출원번호</th>
                        <th>등록번호</th>
                        <th>출원인</th>
                        <th>발명자</th>
                        <th>출원일</th>
                        <th>우선일</th>
                        <th>PCT마감일</th>
                        <th>발명의 명칭</th>
                        <th>현재상태</th>
                        <th>공개전문</th>
                        <th>공고전문</th>
                    </tr>
                </thead>
                <tbody id="patentTableBody">
                    <!-- 검색 결과가 여기에 표시됩니다 -->
                </tbody>
            </table>
        </div>
    </div>
</main>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-text">
                    <strong>유니크 특허사무소</strong> - 특허 현황 조회 시스템
                </div>
                <div class="footer-contact">
                    <a href="tel:010-3131-7960">📞 010-3131-7960</a>
                    <a href="mailto:ljunhyek@naver.com">✉️ ljunhyek@naver.com</a>
                    <a href="https://unicpat.com" target="_blank">🌐 unicpat.com</a>
                </div>
                <div class="footer-text" style="margin-top: 1rem; font-size: 0.875rem; color: #94a3b8;">
                    © 2024 유니크 특허사무소. All rights reserved.
                </div>
            </div>
        </div>
    </footer>

    <!-- JavaScript -->
    <script src="/js/main.js"></script>

    <!-- 클라이언트 측 인증 체크 -->
    <script>
    (function() {
        var cookies = document.cookie.split(';');
        var hasLogin = cookies.some(function(c) { return c.trim().startsWith('loginStatus=') && c.includes('true'); });
        if (!hasLogin) {
            window.location.href = '/';
        }
    })();
    </script>

    <!-- 나의 정보 수정 모달 -->
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        var myInfoBtn = document.getElementById('myInfoBtn');
        if (myInfoBtn) {
            myInfoBtn.addEventListener('click', function(e) {
                e.preventDefault();
                showMyInfoModal();
            });
        }
    });

    function showMyInfoModal() {
        window.closeMyInfoModal = function() {
            var modal = document.getElementById('myInfoModal');
            if (modal) modal.remove();
        };

        var modalHTML = '<div id="myInfoModal" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); display: flex; justify-content: center; align-items: center; z-index: 1000;">' +
            '<div style="background: white; border-radius: 8px; padding: 2rem; width: 90%; max-width: 500px; max-height: 90vh; overflow-y: auto; box-shadow: 0 10px 25px rgba(0,0,0,0.15);">' +
                '<div style="border-bottom: 2px solid #F59E0B; padding-bottom: 1rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">' +
                    '<h2 style="color: #0F172A; font-size: 1.5rem; font-weight: 700; margin: 0;">나의 정보 수정</h2>' +
                    '<button type="button" onclick="closeMyInfoModal()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #6b7280;">&times;</button>' +
                '</div>' +
                '<form id="myInfoForm">' +
                    '<div style="margin-bottom: 1rem;">' +
                        '<label style="display: block; color: #374151; font-weight: 500; margin-bottom: 0.5rem;">현재 이메일 (로그인 ID)</label>' +
                        '<input type="email" id="myinfo_current_email" required style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box; background: #f9fafb;" placeholder="현재 이메일을 입력하세요">' +
                    '</div>' +
                    '<div style="margin-bottom: 1rem;">' +
                        '<label style="display: block; color: #374151; font-weight: 500; margin-bottom: 0.5rem;">현재 패스워드 <span style="color: #ef4444;">*</span></label>' +
                        '<input type="password" id="myinfo_current_password" required style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box;" placeholder="본인 확인을 위해 현재 패스워드를 입력하세요">' +
                    '</div>' +
                    '<hr style="border: none; border-top: 1px solid #e5e7eb; margin: 1.5rem 0;">' +
                    '<p style="color: #6b7280; font-size: 0.85rem; margin-bottom: 1rem;">변경할 항목만 입력하세요. 비워두면 기존 정보가 유지됩니다.</p>' +
                    '<div style="margin-bottom: 1rem;">' +
                        '<label style="display: block; color: #374151; font-weight: 500; margin-bottom: 0.5rem;">새 이메일</label>' +
                        '<input type="email" id="myinfo_new_email" style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box;" placeholder="변경할 이메일 (선택)">' +
                    '</div>' +
                    '<div style="margin-bottom: 1rem;">' +
                        '<label style="display: block; color: #374151; font-weight: 500; margin-bottom: 0.5rem;">연락처</label>' +
                        '<input type="tel" id="myinfo_phone" style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box;" placeholder="변경할 연락처 (선택)">' +
                    '</div>' +
                    '<div style="margin-bottom: 1rem;">' +
                        '<label style="display: block; color: #374151; font-weight: 500; margin-bottom: 0.5rem;">사업자번호</label>' +
                        '<div style="display: flex; gap: 0.5rem;">' +
                            '<input type="text" id="myinfo_business_number" maxlength="10" style="flex: 1; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box;" placeholder="10자리 숫자 (선택)">' +
                            '<button type="button" id="myinfo_lookup_btn" style="padding: 0.75rem 1rem; background: #F59E0B; color: white; border: none; border-radius: 4px; cursor: pointer; white-space: nowrap;">고객번호 조회</button>' +
                        '</div>' +
                    '</div>' +
                    '<div style="margin-bottom: 1rem;">' +
                        '<label style="display: block; color: #374151; font-weight: 500; margin-bottom: 0.5rem;">고객번호</label>' +
                        '<input type="text" id="myinfo_customer_number" maxlength="12" style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box; background: #f9fafb;" placeholder="12자리 숫자 (자동 조회됨)" readonly>' +
                    '</div>' +
                    '<div style="margin-bottom: 1rem;">' +
                        '<label style="display: block; color: #374151; font-weight: 500; margin-bottom: 0.5rem;">새 패스워드</label>' +
                        '<input type="password" id="myinfo_new_password" minlength="6" style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box;" placeholder="변경할 패스워드 (선택, 6자 이상)">' +
                    '</div>' +
                    '<div style="margin-bottom: 1.5rem;">' +
                        '<label style="display: block; color: #374151; font-weight: 500; margin-bottom: 0.5rem;">새 패스워드 확인</label>' +
                        '<input type="password" id="myinfo_new_password_confirm" minlength="6" style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box;" placeholder="새 패스워드를 다시 입력하세요">' +
                    '</div>' +
                    '<div id="myInfoErrorMessage" style="display: none; color: #ef4444; background: #fef2f2; border: 1px solid #fecaca; padding: 0.75rem; border-radius: 4px; margin-bottom: 1rem; font-size: 0.9rem;"></div>' +
                    '<div id="myInfoSuccessMessage" style="display: none; color: #059669; background: #ecfdf5; border: 1px solid #a7f3d0; padding: 0.75rem; border-radius: 4px; margin-bottom: 1rem; font-size: 0.9rem;"></div>' +
                    '<div style="display: flex; gap: 1rem; justify-content: flex-end;">' +
                        '<button type="button" onclick="closeMyInfoModal()" style="padding: 0.75rem 1.5rem; border: 1px solid #d1d5db; background: white; color: #374151; border-radius: 4px; cursor: pointer; font-weight: 500;">취소</button>' +
                        '<button type="submit" id="myInfoSubmitBtn" style="padding: 0.75rem 1.5rem; background: #F59E0B; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 500;">정보 수정</button>' +
                    '</div>' +
                '</form>' +
            '</div>' +
        '</div>';

        document.body.insertAdjacentHTML('beforeend', modalHTML);

        document.getElementById('myInfoForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            var errorDiv = document.getElementById('myInfoErrorMessage');
            var successDiv = document.getElementById('myInfoSuccessMessage');
            errorDiv.style.display = 'none';
            successDiv.style.display = 'none';

            var currentEmail = document.getElementById('myinfo_current_email').value;
            var currentPassword = document.getElementById('myinfo_current_password').value;
            var newEmail = document.getElementById('myinfo_new_email').value;
            var phone = document.getElementById('myinfo_phone').value;
            var newPassword = document.getElementById('myinfo_new_password').value;
            var newPasswordConfirm = document.getElementById('myinfo_new_password_confirm').value;

            if (!currentEmail || !currentPassword) {
                errorDiv.textContent = '현재 이메일과 패스워드를 입력해주세요.';
                errorDiv.style.display = 'block';
                return;
            }
            if (newPassword && newPassword !== newPasswordConfirm) {
                errorDiv.textContent = '새 패스워드가 일치하지 않습니다.';
                errorDiv.style.display = 'block';
                return;
            }
            if (newPassword && newPassword.length < 6) {
                errorDiv.textContent = '새 패스워드는 6자 이상이어야 합니다.';
                errorDiv.style.display = 'block';
                return;
            }
            var businessNumber = document.getElementById('myinfo_business_number').value.trim();
            var customerNumber = document.getElementById('myinfo_customer_number').value.trim();

            if (!newEmail && !phone && !newPassword && !businessNumber && !customerNumber) {
                errorDiv.textContent = '변경할 항목을 하나 이상 입력해주세요.';
                errorDiv.style.display = 'block';
                return;
            }

            var submitBtn = document.getElementById('myInfoSubmitBtn');
            submitBtn.disabled = true;
            submitBtn.textContent = '처리 중...';

            try {
                var response = await fetch('/api/update-profile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        current_email: currentEmail,
                        current_password: currentPassword,
                        new_email: newEmail || undefined,
                        phone: phone || undefined,
                        business_number: businessNumber || undefined,
                        customer_number: customerNumber || undefined,
                        new_password: newPassword || undefined
                    })
                });
                var result = await response.json();
                if (result.success) {
                    successDiv.textContent = result.message || '정보가 수정되었습니다.';
                    successDiv.style.display = 'block';
                } else {
                    errorDiv.textContent = result.message || '정보 수정에 실패했습니다.';
                    errorDiv.style.display = 'block';
                }
            } catch (error) {
                errorDiv.textContent = '정보 수정 처리 중 오류가 발생했습니다.';
                errorDiv.style.display = 'block';
            }
            submitBtn.textContent = '정보 수정';
            submitBtn.disabled = false;
        });

        // 사업자번호로 고객번호 조회 버튼 이벤트
        document.getElementById('myinfo_lookup_btn').addEventListener('click', async function() {
            var businessNumber = document.getElementById('myinfo_business_number').value.trim();
            var errorDiv = document.getElementById('myInfoErrorMessage');
            var customerNumberInput = document.getElementById('myinfo_customer_number');

            errorDiv.style.display = 'none';

            if (!businessNumber) {
                errorDiv.textContent = '사업자번호를 입력해주세요.';
                errorDiv.style.display = 'block';
                return;
            }

            if (!/^\d{10}$/.test(businessNumber)) {
                errorDiv.textContent = '사업자번호는 10자리 숫자여야 합니다.';
                errorDiv.style.display = 'block';
                return;
            }

            var lookupBtn = this;
            lookupBtn.disabled = true;
            lookupBtn.textContent = '조회 중...';

            try {
                var response = await fetch('/api/lookup-customer', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ business_number: businessNumber })
                });
                var result = await response.json();

                if (result.success && result.customer_number) {
                    customerNumberInput.value = result.customer_number;
                    customerNumberInput.style.backgroundColor = '#ecfdf5';
                } else {
                    errorDiv.textContent = result.message || '고객번호를 찾을 수 없습니다.';
                    errorDiv.style.display = 'block';
                }
            } catch (error) {
                errorDiv.textContent = '고객번호 조회 중 오류가 발생했습니다.';
                errorDiv.style.display = 'block';
            }

            lookupBtn.disabled = false;
            lookupBtn.textContent = '고객번호 조회';
        });
    }
    </script>

    <!-- 검색 및 이벤트 스크립트 -->
    <script>
    // 검색 폼 제출 이벤트 (추후 키프리스 스크래핑으로 구현 예정)
    document.getElementById('searchForm').addEventListener('submit', async function(e) {
        e.preventDefault();

        const customerNumber = document.getElementById('customerNumber').value.trim();
        const searchBtn = document.getElementById('searchBtn');
        const originalText = searchBtn.innerHTML;

        // 입력 검증 (12자리 숫자)
        if (!/^\d{12}$/.test(customerNumber)) {
            showError('고객번호는 12자리 숫자여야 합니다.');
            return;
        }

        hideError();
        showLoading(searchBtn);

        try {
            // TODO: 키프리스 검색 결과를 가져오는 로직으로 대체 예정
            alert('키프리스 검색 기능이 아직 구현되지 않았습니다.\n고객번호: ' + customerNumber);
        } catch (error) {
            console.error('검색 오류:', error);
            showError(error.message);
        } finally {
            hideLoading(searchBtn, originalText);
        }
    });

    // Event listeners setup
    document.addEventListener('DOMContentLoaded', function() {
        // Logout button
        const logoutBtn = document.getElementById('logoutBtn');
        if (logoutBtn) {
            logoutBtn.addEventListener('click', function(e) {
                e.preventDefault();
                document.cookie = 'loginStatus=; Path=/; Max-Age=0';
                fetch('/api/logout').catch(function() {});
                window.location.href = '/';
            });
        }
    });
    </script>
</body>
</html>
