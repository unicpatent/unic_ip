        function updateNavigation(isLoggedIn) {
            document.getElementById('adminLi').style.display = isLoggedIn ? '' : 'none';
            document.getElementById('logoutLi').style.display = isLoggedIn ? '' : 'none';
        }

        // Check login status on page load
        function checkLoginStatus() {
            var params = new URLSearchParams(window.location.search);
            if (params.get('logout') === '1') {
                document.cookie = 'loginStatus=; Path=/; Max-Age=0';
                updateNavigation(false);
                history.replaceState(null, '', _homePath);
                return;
            }
            if (params.get('adminLogin') === '1') {
                history.replaceState(null, '', _homePath);
                openLoginModal();
            }

            const cookies = document.cookie.split(';');
            const loginCookie = cookies.find(cookie => cookie.trim().startsWith('loginStatus='));
            const adminCookie = cookies.find(cookie => cookie.trim() === 'userRole=admin');

            updateNavigation(!!(loginCookie && loginCookie.includes('true') && adminCookie));
