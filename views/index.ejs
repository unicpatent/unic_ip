<!DOCTYPE html>
<html lang="<%= lang === 'en' ? 'en' : 'ko' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <% if (lang === 'en') { %>
    <title>Unic Patent Office - AI Patent Search System | Real-time Patent Status</title>
    <meta name="description" content="Unic Patent Office's real-time AI patent search system. Search and manage registered patents, annual fee status, and pending applications using your business number or patent customer number.">
    <meta name="keywords" content="patent search, registered patent, patent application, annual fee, patent management, Unic Patent Office, AI patent search">
    <meta property="og:title" content="Unic Patent Office - AI Patent Search System">
    <meta property="og:description" content="Search and manage registered patents, annual fee status, and pending applications in one place.">
    <meta property="og:locale" content="en_US">
    <% } else { %>
    <title>유니크 특허사무소 - AI 특허 검색 시스템 | 실시간 등록특허 출원특허 조회</title>
    <meta name="description" content="유니크 특허사무소의 실시간 AI 특허 검색 시스템입니다. 사업자번호와 특허고객번호로 등록특허, 연차료 납부상황, 출원특허를 한번에 통합 검색하고 관리하세요.">
    <meta name="keywords" content="특허검색, 등록특허, 출원특허, 연차료, 특허관리, 유니크특허사무소, 특허사무소, AI특허검색, 실시간특허조회">
    <meta property="og:title" content="유니크 특허사무소 - AI 특허 검색 시스템">
    <meta property="og:description" content="사업자번호와 특허고객번호로 등록특허, 연차료 납부상황, 출원특허를 한번에 통합 검색하고 관리할 수 있는 실시간 특허 검색 플랫폼입니다.">
    <meta property="og:locale" content="ko_KR">
    <% } %>
    <meta name="author" content="유니크 특허사무소">
    <link rel="canonical" href="https://www.ipbot1.com/<%= lang === 'en' ? 'en' : '' %>">
    <link rel="alternate" hreflang="ko" href="https://www.ipbot1.com/">
    <link rel="alternate" hreflang="en" href="https://www.ipbot1.com/en">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://www.ipbot1.com/<%= lang === 'en' ? 'en' : '' %>">
    <meta property="og:site_name" content="유니크 특허사무소">
    <meta name="robots" content="index, follow">
    <meta name="google-site-verification" content="PKZLgjFaj9UD2qw93XhI2wCPWORLW7oFHt0Ypne3h7Y" />
    <meta name="naver-site-verification" content="3b649a15c022c58ce4938ec678bd5f61fb80b531" />
    <link rel="stylesheet" href="/css/style.css">

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#2563eb">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="유니크특허">
    <link rel="apple-touch-icon" href="/images/icon-192x192.png">
</head>
<body>
    <header>
        <!-- Language Bar -->
        <div class="lang-bar">
            <a href="/" class="<%= lang !== 'en' ? 'active' : '' %>">한국어</a>
            <span>|</span>
            <a href="/en" class="<%= lang === 'en' ? 'active' : '' %>">English</a>
        </div>
        <nav class="navbar">
            <div class="nav-brand">
                <img src="/images/logo.png" alt="<%= lang === 'en' ? 'Logo' : '로고' %>" class="logo">
                <span><%= lang === 'en' ? 'Unic Patent Office' : '유니크 특허사무소' %></span>
            </div>
            <button class="hamburger" id="hamburgerBtn" aria-label="<%= lang === 'en' ? 'Open menu' : '메뉴 열기' %>">
                <span></span>
                <span></span>
                <span></span>
            </button>
            <ul class="nav-menu" id="navMenu">
                <li id="loginLi"><a href="#" id="loginBtn"><%= lang === 'en' ? 'Login' : '로그인' %></a></li>
                <li id="serviceApplicationLi"><a href="#" id="serviceApplicationBtn"><%= lang === 'en' ? 'Sign Up' : '서비스 이용신청' %></a></li>
                <li><a href="#" id="registeredBtn"><%= lang === 'en' ? 'Registered Patents' : '등록특허 현황' %></a></li>
                <li><a href="#" id="applicationBtn"><%= lang === 'en' ? 'Patent Applications' : '출원특허 현황' %></a></li>
                <li><a href="https://www.unicpat.com" target="_blank"><%= lang === 'en' ? 'Unic Website' : '유니크 홈페이지' %></a></li>
                <li id="myInfoLi" style="display:none;"><a href="#" id="myInfoBtn"><%= lang === 'en' ? 'My Profile' : '나의 정보 수정' %></a></li>
                <li id="logoutLi" style="display:none;"><a href="#" id="logoutBtn"><%= lang === 'en' ? 'Logout' : '로그아웃' %></a></li>
            </ul>
        </nav>
    </header>

    <main>
        <section class="hero">
            <div class="hero-overlay"></div>
            <div class="hero-content">
                <% if (lang === 'en') { %>
                <h1 style="color: #000; font-weight: 700;">Your Complete Patent Management</h1>
                <h2 style="color: #000; font-weight: 800;">Find and manage with Unic in real time</h2>
                <p style="color: #000; font-weight: 500; line-height: 1.8; opacity: 0.9;">An innovative patent search platform that lets you search and manage registered patents, real-time annual fee status, and pending applications — all in one place, using your business number or patent customer number.</p>
                <button class="cta-button">Patent Search</button>
                <% } else { %>
                <h1 style="color: #000; font-weight: 700;">내 특허의 모든 것</h1>
                <h2 style="color: #000; font-weight: 800;">유니크에서 실시간으로 찾고 관리하세요</h2>
                <p style="color: #000; font-weight: 500; line-height: 1.8; opacity: 0.9;">사업자번호와 특허고객번호로 등록 특허, 실시간 연차료 납부상황, 출원 특허를 한번에 통합 검색하고 관리할 수 있는 혁신적인 특허 검색 플랫폼입니다.</p>
                <button class="cta-button">특허검색</button>
                <% } %>
            </div>
        </section>

        <section class="mobile-features">
            <div class="container">
                <h3><%= lang === 'en' ? 'All patent information at a glance' : '모든 특허 정보를 한 눈에 볼 수 있어요' %></h3>

                <div class="mobile-content">
                    <div class="mobile-mockup">
                        <div class="mobile-screen">
                            <div class="mobile-header"><%= lang === 'en' ? 'Patent Search Results' : '특허검색 결과' %></div>
                            <div class="mobile-list">
                                <div class="mobile-item"></div>
                                <div class="mobile-item"></div>
                                <div class="mobile-item"></div>
                            </div>
                        </div>
                    </div>

                    <div class="feature-list">
                        <div class="feature-item">
                            <div class="feature-icon">📊</div>
                            <div class="feature-text">
                                <% if (lang === 'en') { %>
                                <h4>Real-time patent information — get the latest updates anytime</h4>
                                <p>Synchronized with the Korean Intellectual Property Office in real time</p>
                                <% } else { %>
                                <h4>실시간 특허정보 제공을 통해서 언제든 최신정보를 얻을 수 있어요</h4>
                                <p>특허청과 실시간 연동하여 최신 정보를 제공합니다</p>
                                <% } %>
                            </div>
                        </div>

                        <div class="feature-item">
                            <div class="feature-icon">🔍</div>
                            <div class="feature-text">
                                <% if (lang === 'en') { %>
                                <h4>Search registered patents, annual fee status, and applications easily with your business number</h4>
                                <p>Accurate and detailed search to find the information you need quickly</p>
                                <% } else { %>
                                <h4>사업자 번호로 등록특허, 연차료 납부상황, 출원특허 정보를 쉽게 검색하세요</h4>
                                <p>정확하고 세밀한 검색으로 원하는 정보를 빠르게 찾을 수 있어요</p>
                                <% } %>
                            </div>
                        </div>

                        <div class="feature-item">
                            <div class="feature-icon">📱</div>
                            <div class="feature-text">
                                <% if (lang === 'en') { %>
                                <h4>Optimized for easy viewing on any device</h4>
                                <p>Access your patent information conveniently from any device</p>
                                <% } else { %>
                                <h4>특허정보를 보다 간편하게 볼 수 있도록 최적화된 환경을 제공해요</h4>
                                <p>어떤 기기에서든 편리하게 특허정보를 확인하실 수 있습니다</p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="contact">
            <div class="container">
                <div class="contact-content">
                    <div class="contact-info">
                        <% if (lang === 'en') { %>
                        <h3>Have questions about our service?<br>Contact us anytime</h3>
                        <% } else { %>
                        <h3>자세한 서비스 문의 및 <br>궁금한 점이 있으시면 연락주세요</h3>
                        <% } %>

                        <div class="contact-details">
                            <div class="contact-logo">
                                <img src="/images/logo.png" alt="<%= lang === 'en' ? 'Unic Logo' : '유니크 로고' %>">
                                <span><%= lang === 'en' ? 'Unic Patent Office' : '유니크 특허사무소' %></span>
                            </div>

                            <div class="contact-text">
                                <p>Real Time AI Patent Search System</p>
                                <% if (lang === 'en') { %>
                                <p>A real-time patent information search system linked with KIPO</p>
                                <p>We are happy to assist you at any time.</p>
                                <% } else { %>
                                <p>특허청과 연계된 실시간 특허정보검색시스템입니다</p>
                                <p>언제든지 연락주시면 친절하게 안내해드리겠습니다.</p>
                                <% } %>

                                <div class="contact-methods">
                                    <div class="contact-method">📞 <%= lang === 'en' ? 'Phone' : '전화번호' %>: 010-3131-7960</div>
                                    <div class="contact-method">📧 Email: ljunhyek@naver.com</div>
                                    <div class="contact-method">🌐 Website: www.unicpat.com</div>
                                </div>
                            </div>
                        </div>

                        <button class="contact-button"><%= lang === 'en' ? 'Contact Us' : '서비스문의' %></button>
                    </div>

                    <div class="contact-features">
                        <div class="feature-badge">
                            <div class="badge-icon">🏛️</div>
                            <% if (lang === 'en') { %>
                            <p>Accurate information through real-time integration<br>with the Korean Intellectual Property Office.</p>
                            <% } else { %>
                            <p>정부기관 특허청과의 실시간 연동으로 정확한 정보를<br>제공해드립니다.</p>
                            <% } %>
                        </div>

                        <div class="feature-badge">
                            <div class="badge-icon">🔍</div>
                            <p><%= lang === 'en' ? 'Precision search engine for customized patent information' : '정밀한 검색엔진 맞춤 특허정보 검색' %></p>
                        </div>

                        <div class="feature-badge">
                            <div class="badge-icon">🤖</div>
                            <% if (lang === 'en') { %>
                            <p>Our accurate and efficient patent search system delivers the information you need quickly and precisely</p>
                            <% } else { %>
                            <p>정확하고 효율적인 특허 검색 시스템으로 원하시는 정보를<br>빠르고 정확하게 제공합니다</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Login Modal -->
    <div id="loginModal" class="modal" style="display: none;">
        <div class="modal-overlay" id="modalOverlay"></div>
        <div class="modal-content">
            <div class="modal-header">
                <h3><%= lang === 'en' ? 'Login' : '로그인' %></h3>
                <button type="button" class="close-btn" id="closeModal">&times;</button>
            </div>
            <div class="modal-body">
                <form id="loginForm" autocomplete="on" novalidate>
                    <div class="form-group">
                        <label for="email"><%= lang === 'en' ? 'Email' : '이메일' %></label>
                        <input type="email" id="email" name="email" required autocomplete="username">
                    </div>
                    <div class="form-group">
                        <label for="password"><%= lang === 'en' ? 'Password' : '패스워드' %></label>
                        <input type="password" id="password" name="password" required autocomplete="current-password">
                    </div>
                    <div id="errorMessage" class="error-message" style="display: none;"></div>
                    <div class="form-actions">
                        <button type="submit" class="login-submit-btn"><%= lang === 'en' ? 'Login' : '로그인' %></button>
                    </div>
                </form>
                <div style="text-align: center; margin-top: 0.75rem;">
                    <a href="#" onclick="event.preventDefault(); closeLoginModal(); showResetPasswordModal();" style="color: #6b7280; font-size: 0.85rem; text-decoration: underline;"><%= lang === 'en' ? 'Forgot your password?' : '패스워드를 잊으셨나요?' %></a>
                </div>
                <div class="service-notice">
                    <p><%= lang === 'en' ? 'Please sign up to use the service.' : '서비스를 이용하기 위해서는 서비스 이용신청을 진행해주세요.' %></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Login JavaScript -->
