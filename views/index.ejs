                                    <input type="text" id="myinfo_business_number"
                                           style="flex: 1; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box;"
                                           placeholder="${_t.bizPlaceholder2}"
                                           maxlength="10">
                                    <span id="myinfo_business_status" style="font-size: 0.85rem; color: #6b7280; white-space: nowrap;"></span>
                                </div>
                            </div>

                            <div style="margin-bottom: 1rem;">
                                <label style="display: block; color: #374151; font-weight: 500; margin-bottom: 0.5rem;">${_t.customerNumber}</label>
                                <input type="text" id="myinfo_customer_number"
                                       style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box;"
                                       placeholder="${_t.customerPlaceholder2}"
                                       maxlength="12">
                                <p id="myinfo_customer_hint" style="font-size: 0.8rem; color: #6b7280; margin-top: 0.25rem;">${_t.customerHint2}</p>
                            </div>

                            <div style="margin-bottom: 1rem;">
                                <label style="display: block; color: #374151; font-weight: 500; margin-bottom: 0.5rem;">${_t.newPassword}</label>
                                <input type="password" id="myinfo_new_password" minlength="6"
                                       style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box;"
                                       placeholder="${_t.newPasswordPlaceholder}">
                            </div>

                            <div style="margin-bottom: 1.5rem;">
                                <label style="display: block; color: #374151; font-weight: 500; margin-bottom: 0.5rem;">${_t.newPasswordConfirm}</label>
                                <input type="password" id="myinfo_new_password_confirm" minlength="6"
                                       style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box;"
                                       placeholder="${_t.newPasswordConfirmPlaceholder}">
                            </div>

                            <div id="myInfoErrorMessage" style="display: none; color: #ef4444; background: #fef2f2; border: 1px solid #fecaca; padding: 0.75rem; border-radius: 4px; margin-bottom: 1rem; font-size: 0.9rem;"></div>
                            <div id="myInfoSuccessMessage" style="display: none; color: #059669; background: #ecfdf5; border: 1px solid #a7f3d0; padding: 0.75rem; border-radius: 4px; margin-bottom: 1rem; font-size: 0.9rem;"></div>

                            <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                                <button type="button" onclick="closeMyInfoModal()" style="padding: 0.75rem 1.5rem; border: 1px solid #d1d5db; background: white; color: #374151; border-radius: 4px; cursor: pointer; font-weight: 500;">${_t.cancel}</button>
                                <button type="submit" id="myInfoSubmitBtn" style="padding: 0.75rem 1.5rem; background: #F59E0B; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 500;">${_t.save}</button>
                            </div>
                        </form>
                    </div>
                </div>
            `;

            document.body.insertAdjacentHTML('beforeend', modalHTML);

            const myinfoBusinessInput = document.getElementById('myinfo_business_number');
            const myinfoCustomerInput = document.getElementById('myinfo_customer_number');
            const myinfoBusinessStatus = document.getElementById('myinfo_business_status');
            const myinfoCustomerHint = document.getElementById('myinfo_customer_hint');

            myinfoBusinessInput.addEventListener('blur', async function() {
                const businessNumber = this.value.replace(/[^0-9]/g, '');

                if (businessNumber.length !== 10) {
                    if (businessNumber.length > 0) {
                        myinfoBusinessStatus.textContent = _t.bizMustBe10;
                        myinfoBusinessStatus.style.color = '#ef4444';
                    } else {
                        myinfoBusinessStatus.textContent = '';
                    }
                    return;
                }

                myinfoBusinessStatus.textContent = _t.lookupLoading;
                myinfoBusinessStatus.style.color = '#6b7280';

                try {
                    const response = await fetch('/api/lookup-customer', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ businessNumber: businessNumber })
                    });

                    const result = await response.json();

                    if (result.success && result.customerNumber) {
                        myinfoCustomerInput.value = result.customerNumber;
                        myinfoBusinessStatus.textContent = _t.lookupDone;
                        myinfoBusinessStatus.style.color = '#059669';
                        myinfoCustomerHint.textContent = result.applicantName ?
                            _t.rightHolder + result.applicantName : _t.customerAutoFilled;
                        myinfoCustomerHint.style.color = '#059669';
                    } else {
                        myinfoBusinessStatus.textContent = _t.lookupNone;
                        myinfoBusinessStatus.style.color = '#f59e0b';
                        myinfoCustomerHint.textContent = result.message || _t.enterManually;
                        myinfoCustomerHint.style.color = '#f59e0b';
                    }
                } catch (error) {
                    console.error('Customer lookup error:', error);
                    myinfoBusinessStatus.textContent = _t.lookupFail;
                    myinfoBusinessStatus.style.color = '#ef4444';
                    myinfoCustomerHint.textContent = _t.enterManually;
                    myinfoCustomerHint.style.color = '#ef4444';
                }
            });

            document.getElementById('myInfoForm').addEventListener('submit', async function(e) {
                e.preventDefault();
                const errorDiv = document.getElementById('myInfoErrorMessage');
                const successDiv = document.getElementById('myInfoSuccessMessage');
                errorDiv.style.display = 'none';
                successDiv.style.display = 'none';

                const currentEmail = document.getElementById('myinfo_current_email').value;
                const currentPassword = document.getElementById('myinfo_current_password').value;
                const newEmail = document.getElementById('myinfo_new_email').value;
                const phone = document.getElementById('myinfo_phone').value;
                const businessNumber = document.getElementById('myinfo_business_number').value;
                const customerNumber = document.getElementById('myinfo_customer_number').value;
                const newPassword = document.getElementById('myinfo_new_password').value;
                const newPasswordConfirm = document.getElementById('myinfo_new_password_confirm').value;

                if (!currentEmail || !currentPassword) {
                    errorDiv.textContent = _t.emailAndPasswordRequired;
                    errorDiv.style.display = 'block';
                    return;
                }

                if (newPassword && newPassword !== newPasswordConfirm) {
                    errorDiv.textContent = _t.newPasswordMismatch;
                    errorDiv.style.display = 'block';
                    return;
                }

                if (newPassword && newPassword.length < 6) {
                    errorDiv.textContent = _t.newPasswordTooShort;
                    errorDiv.style.display = 'block';
                    return;
                }

                if (!newEmail && !phone && !newPassword && !businessNumber && !customerNumber) {
                    errorDiv.textContent = _t.noChanges;
                    errorDiv.style.display = 'block';
                    return;
                }

                const submitBtn = document.getElementById('myInfoSubmitBtn');
                submitBtn.disabled = true;
                submitBtn.textContent = _t.processing;

                try {
                    const response = await fetch('/api/update-profile', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            current_email: currentEmail,
                            current_password: currentPassword,
                            new_email: newEmail || undefined,
                            phone: phone || undefined,
                            business_number: businessNumber || undefined,
                            customer_number: customerNumber || undefined,
                            new_password: newPassword || undefined
                        })
                    });

                    const result = await response.json();

                    if (result.success) {
                        successDiv.textContent = result.message || (_lang === 'en' ? 'Profile updated successfully.' : '정보가 수정되었습니다.');
                        successDiv.style.display = 'block';
                        submitBtn.textContent = _t.save;
                        submitBtn.disabled = false;
                    } else {
                        errorDiv.textContent = result.message || _t.updateFailed;
                        errorDiv.style.display = 'block';
                        submitBtn.textContent = _t.save;
                        submitBtn.disabled = false;
                    }
                } catch (error) {
                    console.error('Update profile error:', error);
                    errorDiv.textContent = _t.updateError;
                    errorDiv.style.display = 'block';
                    submitBtn.textContent = _t.save;
                    submitBtn.disabled = false;
                }
            });
        }

        // 패스워드 찾기 모달 표시
        function showResetPasswordModal() {
            window.closeResetPasswordModal = function() {
                const modal = document.getElementById('resetPasswordModal');
                if (modal) modal.remove();
            };

            const modalHTML = `
                <div id="resetPasswordModal" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); display: flex; justify-content: center; align-items: center; z-index: 1100;">
                    <div style="background: white; border-radius: 8px; padding: 2rem; width: 90%; max-width: 450px; box-shadow: 0 10px 25px rgba(0,0,0,0.15);">
                        <div style="border-bottom: 2px solid #F59E0B; padding-bottom: 1rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
                            <h2 style="color: #0F172A; font-size: 1.3rem; font-weight: 700; margin: 0;">${_t.resetTitle}</h2>
                            <button type="button" onclick="closeResetPasswordModal()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #6b7280;">&times;</button>
                        </div>

                        <p style="color: #6b7280; font-size: 0.9rem; margin-bottom: 1.5rem; line-height: 1.5;">${_t.resetDesc}</p>

                        <form id="resetPasswordForm">
                            <div style="margin-bottom: 1rem;">
                                <label style="display: block; color: #374151; font-weight: 500; margin-bottom: 0.5rem;">${_t.email} <span style="color: #ef4444;">*</span></label>
                                <input type="email" id="reset_email" required
                                       style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box;"
                                       placeholder="${_t.resetEmailPlaceholder}">
                            </div>

                            <div style="margin-bottom: 1.5rem;">
                                <label style="display: block; color: #374151; font-weight: 500; margin-bottom: 0.5rem;">${_t.name} <span style="color: #ef4444;">*</span></label>
                                <input type="text" id="reset_name" required
                                       style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box;"
                                       placeholder="${_t.resetNamePlaceholder}">
                            </div>

                            <div id="resetErrorMessage" style="display: none; color: #ef4444; background: #fef2f2; border: 1px solid #fecaca; padding: 0.75rem; border-radius: 4px; margin-bottom: 1rem; font-size: 0.9rem;"></div>
                            <div id="resetSuccessMessage" style="display: none; color: #059669; background: #ecfdf5; border: 1px solid #a7f3d0; padding: 0.75rem; border-radius: 4px; margin-bottom: 1rem; font-size: 0.9rem;"></div>

                            <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                                <button type="button" onclick="closeResetPasswordModal()" style="padding: 0.75rem 1.5rem; border: 1px solid #d1d5db; background: white; color: #374151; border-radius: 4px; cursor: pointer; font-weight: 500;">${_t.cancel}</button>
                                <button type="submit" id="resetSubmitBtn" style="padding: 0.75rem 1.5rem; background: #F59E0B; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 500;">${_t.resetBtn}</button>
                            </div>
                        </form>
                    </div>
                </div>
            `;

            document.body.insertAdjacentHTML('beforeend', modalHTML);

            document.getElementById('resetPasswordForm').addEventListener('submit', async function(e) {
                e.preventDefault();
                const errorDiv = document.getElementById('resetErrorMessage');
                const successDiv = document.getElementById('resetSuccessMessage');
                errorDiv.style.display = 'none';
                successDiv.style.display = 'none';

                const submitBtn = document.getElementById('resetSubmitBtn');
                submitBtn.disabled = true;
                submitBtn.textContent = _t.processing;

                try {
                    const response = await fetch('/api/reset-password', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            email: document.getElementById('reset_email').value,
                            name: document.getElementById('reset_name').value
                        })
                    });

                    const result = await response.json();

                    if (result.success) {
                        successDiv.innerHTML = _t.tempPassword + '<strong>' + result.temp_password + '</strong><br>' + _t.resetSuccessHint;
                        successDiv.style.display = 'block';
                        submitBtn.style.display = 'none';
                    } else {
                        errorDiv.textContent = result.message || _t.resetFailed;
                        errorDiv.style.display = 'block';
                        submitBtn.textContent = _t.resetBtn;
                        submitBtn.disabled = false;
                    }
                } catch (error) {
                    errorDiv.textContent = _t.resetError;
                    errorDiv.style.display = 'block';
                    submitBtn.textContent = _t.resetBtn;
                    submitBtn.disabled = false;
                }
            });
        }

        // 로그인 상태 확인 함수
        function isLoggedIn() {
            const cookies = document.cookie.split(';');
            const loginCookie = cookies.find(cookie => cookie.trim().startsWith('loginStatus='));
            return loginCookie && loginCookie.includes('true');
        }

        // 등록특허 현황 클릭 핸들러
        registeredBtn.addEventListener('click', function(e) {
            e.preventDefault();
            if (isLoggedIn()) {
                window.location.href = _registeredPath;
            } else {
                alert(_t.loginRequired);
            }
        });

        // 출원특허 현황 클릭 핸들러
        applicationBtn.addEventListener('click', function(e) {
            e.preventDefault();
            if (isLoggedIn()) {
                window.location.href = _applicationPath;
            } else {
                alert(_t.loginRequired);
            }
        });

        // 특허검색 버튼 클릭 핸들러
        const ctaButton = document.querySelector('.cta-button');
        if (ctaButton) {
            ctaButton.addEventListener('click', function(e) {
                e.preventDefault();
                loginModal.style.display = 'block';
                document.body.style.overflow = 'hidden';
            });
        }

    // 서비스 이용신청 - 고객번호 찾기 팝업
    function openLookupWindowService() {
        var w = 420, h = 400;
        var left = (screen.width - w) / 2;
        var top = (screen.height - h) / 2;
        var popup = window.open('', 'lookupCustomer', 'width=' + w + ',height=' + h + ',left=' + left + ',top=' + top + ',scrollbars=no,resizable=no');

        popup.document.write(
            '<!DOCTYPE html><html lang="' + (_lang === 'en' ? 'en' : 'ko') + '"><head><meta charset="UTF-8">' +
            '<title>' + _t.lookupTitle + '</title>' +
            '<style>' +
            'body{font-family:"Noto Sans KR",sans-serif;margin:0;padding:1.5rem;background:#f9fafb;}' +
            'h3{margin:0 0 1rem;color:#1f2937;font-size:1.1rem;}' +
            '.radio-row{display:flex;gap:1.5rem;margin-bottom:1rem;padding:0.6rem 0.75rem;background:#fff;border:1px solid #e5e7eb;border-radius:6px;}' +
            '.radio-row label{font-weight:500;font-size:0.9rem;cursor:pointer;display:flex;align-items:center;gap:0.3rem;}' +
            '.row{display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem;}' +
            'label{font-weight:500;font-size:0.9rem;white-space:nowrap;}' +
            'input[type="text"]{padding:0.5rem 0.75rem;border:1px solid #d1d5db;border-radius:4px;font-size:0.95rem;width:160px;}' +
            '.btn{padding:0.5rem 1rem;border:none;border-radius:4px;cursor:pointer;font-size:0.9rem;font-weight:500;}' +
            '.btn-search{background:#F59E0B;color:white;}' +
            '.btn-patent{background:#3B82F6;color:white;width:100%;padding:0.6rem;}' +
            '.btn-close{background:#6b7280;color:white;width:100%;margin-top:1rem;padding:0.6rem;}' +
            '#result{margin-top:0.75rem;padding:0.75rem;border-radius:6px;display:none;}' +
            '.hint{margin-top:0.75rem;font-size:0.82rem;color:#6b7280;}' +
            '</style></head><body>' +
            '<h3>' + _t.lookupTitle + '</h3>' +
            '<div class="radio-row">' +
            '<label><input type="radio" name="lookupType" value="biz" checked onchange="switchType()"> ' + _t.lookupByBiz + '</label>' +
            '<label><input type="radio" name="lookupType" value="patent" onchange="switchType()"> ' + _t.lookupByPatent + '</label>' +
            '</div>' +
            '<div id="bizSection">' +
            '<div class="row">' +
            '<label>' + _t.lookupBizLabel + '</label>' +
            '<input type="text" id="bizNum" placeholder="' + _t.lookupBizPlaceholder + '" maxlength="10">' +
            '<button class="btn btn-search" onclick="doLookup()">' + _t.lookupSearch + '</button>' +
            '</div>' +
            '<div id="result"></div>' +
            '<div class="hint">' + _t.lookupHint + '</div>' +
            '</div>' +
            '<div id="patentSection" style="display:none;">' +
            '<p style="font-size:0.9rem;color:#374151;margin:0 0 0.75rem;">' + _t.patentDesc + '</p>' +
            '<button class="btn btn-patent" onclick="var pw=900,ph=700,pl=(screen.width-pw)/2,pt=(screen.height-ph)/2;window.open(\'https://www.patent.go.kr/smart/jsp/kiponet/mp/mpopenpatinfo/apagtinfo/ReadApAgtInfoInput.do\',\'patentro\',\'width=\'+pw+\',height=\'+ph+\',left=\'+pl+\',top=\'+pt+\',scrollbars=yes,resizable=yes\')">' + _t.patentLink + '</button>' +
            '</div>' +
            '<button class="btn btn-close" onclick="window.close()">' + _t.close + '</button>' +
            '<script>' +
            'function switchType(){' +
            '  var v=document.querySelector("input[name=lookupType]:checked").value;' +
            '  document.getElementById("bizSection").style.display=v==="biz"?"block":"none";' +
            '  document.getElementById("patentSection").style.display=v==="patent"?"block":"none";' +
            '}' +
            'async function doLookup(){' +
            '  var num=document.getElementById("bizNum").value.replace(/[^0-9]/g,"");' +
            '  var rd=document.getElementById("result");' +
            '  if(num.length!==10){rd.style.display="block";rd.style.background="#fef2f2";rd.innerHTML="<span style=\\"color:#ef4444\\">' + _t.bizMust10 + '</span>";return;}' +
            '  rd.style.display="block";rd.style.background="#f3f4f6";rd.innerHTML="<span style=\\"color:#6b7280\\">' + _t.lookupSearching + '</span>";' +
            '  try{' +
            '    var res=await fetch("/api/lookup-customer",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({businessNumber:num})});' +
