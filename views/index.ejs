            const findCustomerBtnService = document.getElementById('findCustomerBtnService');
            businessNumberInput.addEventListener('input', function() {
                const val = this.value.replace(/[^0-9]/g, '');
                if (findCustomerBtnService) {
                    findCustomerBtnService.style.display = val.length > 0 ? 'none' : 'inline-block';
                }
            });

            businessNumberInput.addEventListener('blur', async function() {
                const businessNumber = this.value.replace(/[^0-9]/g, '');

                if (businessNumber.length !== 10) {
                    if (businessNumber.length > 0) {
                        businessNumberStatus.textContent = _t.bizMustBe10;
                        businessNumberStatus.style.color = '#ef4444';
                    } else {
                        businessNumberStatus.textContent = '';
                    }
                    return;
                }

                businessNumberStatus.textContent = _t.lookupLoading;
                businessNumberStatus.style.color = '#6b7280';

