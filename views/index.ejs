                <li><a href="<%= lang === 'en' ? '/en/application' : '/application2' %>" id="applicationBtn"><%= lang === 'en' ? 'Patent Applications' : '출원특허 현황' %></a></li>
                <li><a href="<%= lang === 'en' ? 'https://www.unicpat.com/en' : 'https://www.unicpat.com' %>" target="_blank"><%= lang === 'en' ? 'Unic Website' : '유니크 홈페이지' %></a></li>
