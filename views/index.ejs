        const loginBtn = document.getElementById('loginBtn');
        const closeModal = document.getElementById('closeModal');
        const modalOverlay = document.getElementById('modalOverlay');
        const loginForm = document.getElementById('loginForm');
        const errorMessage = document.getElementById('errorMessage');
        const logoutBtn = document.getElementById('logoutBtn');
        const registeredBtn = document.getElementById('registeredBtn');
        const applicationBtn = document.getElementById('applicationBtn');

        // Show modal
        loginBtn.addEventListener('click', function(e) {
            e.preventDefault();
            loginModal.style.display = 'block';
            document.body.style.overflow = 'hidden';
        });

        // Close modal
        function closeLoginModal() {
            loginModal.style.display = 'none';
            document.body.style.overflow = 'auto';
            errorMessage.style.display = 'none';
            loginForm.reset();
        }

        closeModal.addEventListener('click', closeLoginModal);
        modalOverlay.addEventListener('click', closeLoginModal);

        // Close modal on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && loginModal.style.display === 'block') {
                closeLoginModal();
            }
        });

        // Handle login form submission
        loginForm.addEventListener('submit', async function(e) {
            e.preventDefault();

            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;

            try {
                const response = await fetch('/api/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ email, password })
                });

                const result = await response.json();

                if (result.success) {
                    closeLoginModal();
                    updateNavigation(true);
                    window.location.href = _registeredPath;
                } else {
                    showError(result.message || _t.loginFailed);
                }
            } catch (error) {
                console.error('Login error:', error);
                showError(_t.loginError);
            }
        });

        // Logout functionality
        logoutBtn.addEventListener('click', function(e) {
            e.preventDefault();
            document.cookie = 'loginStatus=; Path=/; Max-Age=0';
            fetch('/api/logout').catch(function() {});
            window.location.href = _homePath + '?logout=1';
        });

        // Show error message
        function showError(message) {
            errorMessage.textContent = message;
            errorMessage.style.display = 'block';
        }

        // Update navigation based on login status
        const myInfoBtn = document.getElementById('myInfoBtn');
        function updateNavigation(isLoggedIn) {
            var loginLi = document.getElementById('loginLi');
            var serviceApplicationLi = document.getElementById('serviceApplicationLi');
            var myInfoLi = document.getElementById('myInfoLi');
            var logoutLi = document.getElementById('logoutLi');

            if (isLoggedIn) {
                loginLi.style.display = 'none';
                serviceApplicationLi.style.display = 'none';
                myInfoLi.style.display = '';
                logoutLi.style.display = '';
            } else {
                loginLi.style.display = '';
                serviceApplicationLi.style.display = '';
                myInfoLi.style.display = 'none';
                logoutLi.style.display = 'none';
            }
        }

        // Check login status on page load
        function checkLoginStatus() {
            var params = new URLSearchParams(window.location.search);
            if (params.get('logout') === '1') {
                document.cookie = 'loginStatus=; Path=/; Max-Age=0';
                updateNavigation(false);
                history.replaceState(null, '', _homePath);
                return;
            }

            const cookies = document.cookie.split(';');
            const loginCookie = cookies.find(cookie => cookie.trim().startsWith('loginStatus='));

            if (loginCookie && loginCookie.includes('true')) {
                updateNavigation(true);
            } else {
                updateNavigation(false);
            }
        }

