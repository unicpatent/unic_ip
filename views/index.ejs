        // Registered/Application page paths based on language
        const _registeredPath = _lang === 'en' ? '/en/registered' : '/registered';
        const _applicationPath = _lang === 'en' ? '/en/application' : '/application2';
        const _homePath = _lang === 'en' ? '/en' : '/';

        // Modal elements
        const loginModal = document.getElementById('loginModal');
        const closeModal = document.getElementById('closeModal');
        const modalOverlay = document.getElementById('modalOverlay');
        const loginForm = document.getElementById('loginForm');
        const errorMessage = document.getElementById('errorMessage');
        const setPasswordForm = document.getElementById('setPasswordForm');
        let setupToken = null;   // 임시 비밀번호 로그인 시 받은 1회용 설정 토큰
        let setupEmail = '';
        const logoutBtn = document.getElementById('logoutBtn');
        const registeredBtn = document.getElementById('registeredBtn');
        const applicationBtn = document.getElementById('applicationBtn');

        // Show modal (관리자 로그인: /admin 접속 시 /?adminLogin=1 로 이동해 열림)
        function openLoginModal() {
            loginModal.style.display = 'block';
            document.body.style.overflow = 'hidden';
        }

        // Close modal
        function closeLoginModal() {
            loginModal.style.display = 'none';
            document.body.style.overflow = 'auto';
            errorMessage.style.display = 'none';
            loginForm.reset();
            // 새 비밀번호 설정 단계였다면 로그인 단계로 되돌림
            setPasswordForm.reset();
            setPasswordForm.style.display = 'none';
            document.getElementById('setPasswordError').style.display = 'none';
            loginForm.style.display = '';
            setupToken = null;
        }

        closeModal.addEventListener('click', closeLoginModal);
        modalOverlay.addEventListener('click', closeLoginModal);

        // 관리자 계정 복구 (이메일·비밀번호 분실)
        document.getElementById('recoveryToggle').addEventListener('click', function() {
            const panel = document.getElementById('recoveryPanel');
            panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
        });
        document.getElementById('recoveryBtn').addEventListener('click', async function() {
            const btn = this;
            const msg = document.getElementById('recoveryMessage');
            const show = function(text, ok) {
                msg.textContent = text;
                msg.style.display = 'block';
                msg.style.background = ok ? '#f0fdf4' : '#fef2f2';
                msg.style.color = ok ? '#166534' : '#b91c1c';
            };
            btn.disabled = true;
            try {
                const res = await fetch('/api/admin/recovery/request', { method: 'POST' });
                const data = await res.json();
                show(data.message || (_lang === 'en' ? 'Request failed.' : '요청에 실패했습니다.'), data.success);
            } catch (e) {
                show(_lang === 'en' ? 'Server error. Please try again.' : '서버 오류가 발생했습니다. 다시 시도해주세요.', false);
            }
            btn.disabled = false;
        });

        // Close modal on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && loginModal.style.display === 'block') {
                closeLoginModal();
            }
        });

        // Handle login form submission
        loginForm.addEventListener('submit', async function(e) {
            e.preventDefault();

            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;

            try {
                const response = await fetch('/api/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ email, password })
                });

                const result = await response.json();

                if (result.success && result.user && result.user.role === 'admin') {
                    closeLoginModal();
                    window.location.href = '/admin';
                } else if (result.mustSetPassword) {
                    // Supabase에서 넣어 둔 임시 비밀번호로 로그인 → 새 비밀번호 설정 단계
                    setupToken = result.setupToken;
                    setupEmail = email;
                    errorMessage.style.display = 'none';
                    loginForm.style.display = 'none';
                    setPasswordForm.style.display = '';
                    document.getElementById('newPassword').focus();
                } else if (result.success) {
                    // 일반 회원 로그인은 더 이상 필요 없음 (검색은 로그인 없이 이용)
                    fetch('/api/logout').catch(function() {});
                    showError(_lang === 'en' ? 'Login is for administrators only. You can search without logging in.' : '관리자 전용 로그인입니다. 특허 검색은 로그인 없이 이용하실 수 있습니다.');
                } else {
                    showError(result.message || _t.loginFailed);
                }
            } catch (error) {
                console.error('Login error:', error);
                showError(_t.loginError);
            }
        });

        // 새 비밀번호 설정 → 저장 후 새 비밀번호로 바로 로그인
        setPasswordForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const errorDiv = document.getElementById('setPasswordError');
            const btn = document.getElementById('setPasswordBtn');
            const newPassword = document.getElementById('newPassword').value;
            const fail = function(message) {
                errorDiv.textContent = message;
                errorDiv.style.display = 'block';
                btn.disabled = false;
            };
            errorDiv.style.display = 'none';
            if (newPassword.length < 8) return fail(_lang === 'en' ? 'Password must be at least 8 characters.' : '새 비밀번호는 8자 이상이어야 합니다.');
            if (newPassword !== document.getElementById('newPasswordConfirm').value) return fail(_lang === 'en' ? 'Passwords do not match.' : '새 비밀번호와 확인 값이 일치하지 않습니다.');

            btn.disabled = true;
            try {
                const resetRes = await fetch('/api/admin/recovery/reset', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ token: setupToken, password: newPassword })
                });
                const resetResult = await resetRes.json();
                if (!resetResult.success) return fail(resetResult.message);

                const loginRes = await fetch('/api/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: setupEmail, password: newPassword })
                });
                const loginResult = await loginRes.json();
                if (loginResult.success) {
                    window.location.href = '/admin';
                } else {
                    fail(loginResult.message || _t.loginFailed);
                }
            } catch (error) {
                fail(_t.loginError);
            }
        });

        // Logout functionality
        logoutBtn.addEventListener('click', function(e) {
            e.preventDefault();
